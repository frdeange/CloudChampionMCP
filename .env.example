# URL del feed de contenido de Cloud Champion
CLOUDCHAMPION_FEED_URL=https://www.cloudchampion.es/wp-json/feed/content

# Tiempo de vida de la caché en segundos (default: 10 minutos)
CACHE_TTL_SECONDS=600

# Transporte MCP: streamable-http | sse | stdio
MCP_TRANSPORT=streamable-http

# Host y puerto de escucha
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
